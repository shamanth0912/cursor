# --- Organization ---
ORG_DOMAINS=company.com,company.co.uk
ORG_BRANDS=microsoft,google,apple,paypal,amazon,okta,docusign,adobe,zoom,salesforce

# --- Jira Cloud (or DC) ---
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=soc@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_JQL=project = PHISH AND labels != phishintel-analyzed AND attachments is not EMPTY
JIRA_ANALYZED_LABEL=phishintel-analyzed
# Optional: custom field id to store the verdict string
# JIRA_VERDICT_FIELD=customfield_12345
JIRA_WEBHOOK_SECRET=change-me

# --- VirusTotal ---
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_SUBMIT_UNKNOWN=false
VIRUSTOTAL_UPLOAD_ATTACHMENTS=false

# --- urlscan.io ---
URLSCAN_API_KEY=
URLSCAN_VISIBILITY=private
URLSCAN_SUBMIT=true
URLSCAN_POLL_TIMEOUT_SECONDS=45

# --- Mimecast API 2.0 (preferred) ---
MIMECAST_CLIENT_ID=
MIMECAST_CLIENT_SECRET=
MIMECAST_BASE_URL=https://api.services.mimecast.com

# --- Mimecast API 1.0 (HMAC fallback) ---
MIMECAST_ACCESS_KEY=
MIMECAST_SECRET_KEY=
MIMECAST_APP_ID=
MIMECAST_APP_KEY=
MIMECAST_API1_BASE_URL=https://us-api.mimecast.com

# Optional Mimecast extras (can be slow)
MIMECAST_LOOKUP_MESSAGE=true
MIMECAST_LOOKUP_CLICK_LOGS=false

# --- AI verdict (OpenAI-compatible and/or Anthropic) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Runtime ---
MAX_URLS=15
HOST=0.0.0.0
PORT=8080
POLL_INTERVAL_SECONDS=60
